Options -Indexes -FollowSymLinks
ServerSignature Off

# ── Rewrite engine ────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Force HTTPS in production (uncomment when behind SSL)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Block access to sensitive files and directories
    RewriteRule ^(vendor|config|middleware|services|helpers|error_logs|lang)/  - [F,L]
    RewriteRule ^composer\.(json|lock)$  - [F,L]
    RewriteRule ^\.env$                  - [F,L]
    RewriteRule ^\.git                   - [F,L]

    # Allow real files and directories through
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Route everything else to index.php
    RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>

# ── Security headers (additional to PHP layer) ────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Frame-Options            "DENY"
    Header always set X-Content-Type-Options     "nosniff"
    Header always set X-XSS-Protection           "1; mode=block"
    Header always set Referrer-Policy            "strict-origin-when-cross-origin"
    Header always set Permissions-Policy         "camera=(), microphone=(), geolocation=()"
    Header always unset X-Powered-By
    Header always unset Server

    # Cache control for assets
    <FilesMatch "\.(css|js|woff2?|ttf|eot|svg|png|jpg|jpeg|webp|avif|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # No cache for PHP pages
    <FilesMatch "\.php$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

# ── Block direct access to sensitive extensions ───────────────────────────────
<FilesMatch "\.(log|sql|env|sh|bak|htpasswd|json|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Allow access to composer.json only from localhost during dev
<Files "composer.json">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</Files>

# ── Disable unnecessary HTTP methods ─────────────────────────────────────────
<LimitExcept GET POST HEAD>
    Order allow,deny
    Deny from all
</LimitExcept>

# ── Compression ───────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── MIME types ────────────────────────────────────────────────────────────────
<IfModule mod_mime.c>
    AddType application/javascript  .js
    AddType text/css                .css
    AddType image/svg+xml           .svg
    AddType image/webp              .webp
    AddType font/woff2              .woff2
</IfModule>

# ── PHP hardening (if using .htaccess-level PHP config) ──────────────────────
<IfModule mod_php.c>
    php_flag display_errors     Off
    php_flag log_errors         On
    php_value error_log         error_logs/app.log
    php_flag expose_php         Off
    php_flag allow_url_fopen    Off
    php_flag allow_url_include  Off
    php_value session.cookie_httponly 1
    php_value session.cookie_samesite Lax
    php_value session.use_strict_mode 1
</IfModule>
